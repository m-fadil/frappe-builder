# Reference: https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md
# Ordered by the sequence you fill it in. Each `##` section names the compose files that read
# it, so you can skip whole sections you do not merge into COMPOSE_FILE.

## Project identity, fill this first. Used by docker compose itself.
# Lets a copy of this file drive one project on its own, so `docker compose --env-file <file> ...`
# needs no `-p` or `-f` flags. Useful when one server runs several benches.
# COMPOSE_FILE is a `:` separated list in merge order, use absolute paths so the commands work
# from any directory. See docs/02-setup/09-multi-project-env-files.md
# Optional. Left commented, COMPOSE_PROJECT_NAME falls back to the directory name and
# COMPOSE_FILE to `compose.yaml`. Uncomment both to pin them
#COMPOSE_PROJECT_NAME=erpnext-one
#COMPOSE_FILE=/home/ubuntu/frappe_docker/compose.yaml:/home/ubuntu/frappe_docker/overrides/compose.mariadb.yaml:/home/ubuntu/frappe_docker/overrides/compose.redis.yaml:/home/ubuntu/frappe_docker/overrides/compose.https.yaml

## Image. Used by compose.yaml and every override that runs a bench container.
# Required, it is the image tag used when CUSTOM_TAG is empty. No default.
ERPNEXT_VERSION=v16.33.0

# Image used by every Frappe service. Defaults to `frappe/erpnext:$ERPNEXT_VERSION`.
# Set both when you build a custom image with your own apps, see
# docs/02-setup/02-build-setup.md#define-custom-apps
# Optional. Defaults: CUSTOM_IMAGE `frappe/erpnext`, CUSTOM_TAG `$ERPNEXT_VERSION`.
CUSTOM_IMAGE=
CUSTOM_TAG=

# Default value is `always`, so every start pulls the tag again. Set it to `missing` when you
# pin immutable tags and pull them yourself, to keep deploy downtime down.
# Optional, default `always`.
PULL_POLICY=

# Restart policy for the Frappe services. Default value is `unless-stopped`.
# Optional, default `unless-stopped`.
RESTART_POLICY=

## Database. Used by compose.mariadb.yaml, compose.mariadb-shared.yaml, compose.postgres.yaml,
## compose.mariadb-secrets.yaml and compose.restore.yaml.
# Root password of the database server. Also used when restoring a backup.
# Optional, default `123`, except with compose.mariadb-shared.yaml where it is `changeit`.
DB_PASSWORD=123

# Root user of the database server. Default value is `root`.
# Only read by compose.restore.yaml, which needs it to drop and recreate the site database.
# Optional, default `root`.
DB_ROOT_USER=root

# Only with compose.mariadb-secrets.yaml, which reads the password from a docker secret
# instead of DB_PASSWORD above.
# Required by that override, no default. Ignored otherwise.
DB_PASSWORD_SECRETS_FILE=

# Only if you use an external database, so without compose.mariadb.yaml or compose.postgres.yaml
# Optional, both empty by default, which only works with a bundled database override.
DB_HOST=
DB_PORT=

## Redis. Used by compose.yaml.
# Only if you use external Redis, so without compose.redis.yaml
# Optional, both empty by default, which only works with compose.redis.yaml.
REDIS_CACHE=
REDIS_QUEUE=

## Sites and routing. Which proxy override you merged decides what you set here.
# Only with traefik overrides: compose.proxy.yaml, compose.https.yaml, compose.multi-bench*.yaml
# Single site: SITES_RULE=Host(`erp.example.com`)
# Multiple sites: SITES_RULE=Host(`a.example.com`) || Host(`b.example.com`)
# More https://doc.traefik.io/traefik/routing/routers/#rule
# About acme https://doc.traefik.io/traefik/https/acme/#domain-definition
# Required by those overrides, no default.
SITES_RULE=Host(`erp.example.com`)

# Only with nginxproxy overrides: compose.nginxproxy.yaml, compose.nginxproxy-ssl.yaml
# Single site: NGINX_PROXY_HOSTS=erp.example.com
# Multiple sites: NGINX_PROXY_HOSTS=erp.example.com,www.erp.example.com
# Required by those overrides, no default.
NGINX_PROXY_HOSTS=erp.example.com

# Only with HTTPS overrides: compose.https.yaml, compose.nginxproxy-ssl.yaml
# Address Let's Encrypt sends certificate expiry notices to.
# Required by those overrides, no default.
LETSENCRYPT_EMAIL=mail@example.com

# Only with compose.noproxy.yaml and the proxy overrides. Default value is `8080`.
# Optional, default `8080` with compose.noproxy.yaml and `80` with every proxy override.
HTTP_PUBLISH_PORT=

# Only with HTTPS overrides. Default value is `443`.
# Optional, default `443`.
HTTPS_PUBLISH_PORT=

# Default value is `$$host` which resolves site by host. For example, if your host is `example.com`,
# site's name should be `example.com`, or if host is `127.0.0.1` (local debugging), it should be `127.0.0.1`.
# This variable allows to override described behavior. Let's say you create site named `mysite`
# and do want to access it by `127.0.0.1` host. Than you would set this variable to `mysite`.
# Optional, default `$$host`.
FRAPPE_SITE_NAME_HEADER=

## Frontend nginx tuning, optional. Used by compose.yaml.
# Default value is `127.0.0.1`. Set IP address as our trusted upstream address.
# Optional, default `127.0.0.1`.
UPSTREAM_REAL_IP_ADDRESS=

# Default value is `X-Forwarded-For`. Set request header field whose value will be used to replace the client address
# Optional, default `X-Forwarded-For`.
UPSTREAM_REAL_IP_HEADER=

# Allowed values are on|off. Default value is `off`. If recursive search is disabled,
# the original client address that matches one of the trusted addresses
# is replaced by the last address sent in the request header field defined by the real_ip_header directive.
# If recursive search is enabled, the original client address that matches one of the trusted addresses is replaced by the last non-trusted address sent in the request header field.
# Optional, default `off`.
UPSTREAM_REAL_IP_RECURSIVE=

# All Values Allowed by nginx proxy_read_timeout are allowed, default value is 120s
# Useful if you have longrunning print formats or slow loading sites
# Optional, default `120`.
PROXY_READ_TIMEOUT=

# All Values allowed by nginx client_max_body_size are allowed, default value is 50m
# Necessary if the upload limit in the frappe application is increased
# Optional, default `50m`.
CLIENT_MAX_BODY_SIZE=

## Backend performance, optional. Used by compose.yaml.
# The number of threads per Gunicorn worker process for handling concurrent requests.
# Optional, default `4`.
GUNICORN_THREADS=4

# The number of worker processes for handling requests.
# A typical formula is (2 x number of CPU cores) + 1.
# Optional, default `2`.
GUNICORN_WORKERS=2

# Workers exceeding this timeout (in seconds) will be killed and restarted.
# Optional, default `120`.
GUNICORN_TIMEOUT=120

## Optional services, only if you merged the matching override.
# Only with compose.migrator.yaml
# Whether the migrator container runs `bench --site all migrate`. Default value is `true`.
# Note that it runs on every `docker compose up -d`, not only when the image changes.
# Optional, default `true`.
MIGRATE_SITES=

# Only with compose.backup-cron.yaml
# Ofelia schedule for `bench --site all backup`. Default value is `@every 6h`.
# Optional, default `@every 6h`.
BACKUP_CRONSTRING=

## Cloudflare tunnel. Used by compose.proxy-tunnel.yaml and compose.proxy-tunnel-token.yaml.
# Path to the Docker socket that Traefik reads to discover containers, mounted read-only.
# Default value is `/var/run/docker.sock`. Set it if the socket lives elsewhere, for example
# `/run/user/1000/docker.sock` for rootless Docker or `/var/run/podman/podman.sock` for Podman.
# Optional, default `/var/run/docker.sock`.
DOCKER_SOCKET=

# Required by compose.proxy-tunnel-token.yaml.
# Token of a named Cloudflare Tunnel, copied from the Cloudflare Zero Trust dashboard.
# It carries the tunnel's credentials, so treat this file as a secret.
# compose.proxy-tunnel.yaml runs a quick tunnel instead and needs no token.
# Required by compose.proxy-tunnel-token.yaml, no default.
TUNNEL_TOKEN=eyJhIjoi...

## Custom domain. Used by compose.custom-domain.yaml and compose.custom-domain-ssl.yaml.
# ROUTER names the Traefik router and must be unique per domain, BASE_SITE is the site the
# custom domain is rewritten to, BENCH_NETWORK is the existing docker network of the bench.
# Keep these commented out unless you use the overrides: they are checked with `${VAR?...}`,
# which only rejects an unset variable, so an empty value passes the check and breaks silently.
# All three required by those overrides, no defaults.
#ROUTER=erp-custom
#BASE_SITE=erp.example.com
#BENCH_NETWORK=erpnext-one_default

## Standalone Traefik stack, belongs in its own env file, not in a bench project file.
## Used by compose.traefik.yaml and compose.traefik-ssl.yaml.
# These configure the shared Traefik instance that fronts every bench on a server, which is
# started separately with its own `~/gitops/traefik.env`. See
# docs/02-setup/07-single-server-example.md
# HASHED_PASSWORD is the output of `openssl passwd -apr1 <password>`.
# All three required by those overrides, no defaults.
TRAEFIK_DOMAIN=
EMAIL=
HASHED_PASSWORD=

## Refreshing a copy from another site. Used by compose.restore.yaml and compose.sanitize.yaml.
# Pulls the latest database backup from RESTORE_SOURCE_URL and restores it into RESTORE_SITE,
# which drops that site's existing database. Leave empty unless you are running the restore.
# RESTORE_TOKEN is `<api_key>:<api_secret>` of a user on the source site that may read backups,
# No defaults. Empty means the service refuses to run.
# Required
RESTORE_SITE=
RESTORE_SOURCE_URL=
RESTORE_SOURCE_TOKEN=
# Optional, default `admin`
RESTORE_ADMIN_PASSWORD=

# Turns a restored production copy into a safe non-production site: no outgoing mail, no
# incoming mail polling, no webhooks. Defaults to RESTORE_SITE.
# Optional, defaults to RESTORE_SITE.
SANITIZE_SITE=

# Comma separated Single doctypes whose `enabled` field is set to 0 by compose.sanitize.yaml.
# Doctypes from apps that are not installed are ignored. Empty skips the step.
# Optional, default `FCM Settings,TP Twilio Settings,TP Exotel Settings`.
SANITIZE_SINGLES=FCM Settings,TP Twilio Settings,TP Exotel Settings
